# PostgreSQL connection string (e.g. from Neon: https://neon.tech, or Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/efeoattendance?sslmode=require"

# NextAuth
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used by the seed script to create the first admin account
SEED_ADMIN_NAME="EFEO Admin"
SEED_ADMIN_EMAIL="admin@efeo.example"
SEED_ADMIN_PASSWORD="change-me-now"

# Email notifications (OPTIONAL — leave blank to disable; the app works without email).
# Gmail example (recommended): create an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on the account).
# Then use that 16-character password below (NOT your normal Gmail password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="youradmin@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="EFEO Attendance <youradmin@gmail.com>"
